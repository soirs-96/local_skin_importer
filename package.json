{
  "name": "lol-skin-local-importer",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop tool to sync owned LOL skins to lol-skin-api.",
  "author": "soirs-96",
  "license": "MIT",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --win --x64",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,html}\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "element-plus": "2.14.4",
    "axios": "1.7.7",
    "pinia": "3.0.4",
    "vue": "3.5.41",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.18.13",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/test-utils": "2.4.6",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "electron-vite": "3.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.10.0",
    "jsdom": "27.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "vue-tsc": "3.3.9"
  }
}
